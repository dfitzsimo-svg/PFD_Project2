M107
;TYPE:Custom
; Filament-specific end gcode 
;END gcode for filament
G1 Z10.1 F600 ; Move print head up
G1 X5 Y256 F9000 ; present print
G1 Z78.1 F600 ; Move print head further up
G1 Z240 F600 ; Move print head further up
M140 S0 ; turn off heatbed
M104 S0 ; turn off temperature
M107 ; turn off fan
M84 X Y E ; disable motors
; objects_info = {"objects":[]}
; filament used [mm] = 4868.67
; filament used [cm3] = 11.71
; total filament used [g] = 0.00
; total filament cost = 0.00
